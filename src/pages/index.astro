		<style>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			:root {
				--bg-dark: #050b07;
				--bg-medium: #08130d;
				--text-light: #e6f3e7;
				--text-muted: #a6c0aa;
				--accent-gold: #cfb26a;
				--accent-green: #3d754f;
				--accent-teal: #5e946a;
				--symbol-color: rgba(114, 168, 129, 0.35);
			}

			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				background:
					radial-gradient(circle at 20% 14%, rgba(207, 178, 106, 0.08), transparent 40%),
					radial-gradient(circle at 85% 15%, rgba(61, 117, 79, 0.18), transparent 45%),
					linear-gradient(180deg, var(--bg-medium) 0%, var(--bg-dark) 55%, #040804 100%);
				color: var(--text-light);
				font-family: 'EB Garamond', Georgia, serif;
				overflow-x: hidden;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.curiosity-cabinet {
				position: relative;
				min-height: 100vh;
				width: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem 1rem;
			}

			/* Symbol field - many small symbols scattered */
			.symbol-field {
				position: fixed;
				inset: 0;
				pointer-events: none;
				z-index: 1;
				display: grid;
				grid-template-columns: repeat(10, 1fr);
				grid-template-rows: repeat(5, 1fr);
				gap: 1rem;
				padding: 2rem;
			}

			.symbol {
				width: 100%;
				height: 100%;
				max-width: 40px;
				max-height: 40px;
				fill: var(--symbol-color);
				stroke: var(--symbol-color);
				stroke-width: 1;
				opacity: 0.6;
				justify-self: center;
				align-self: center;
			}

			/* Distribute symbols with varying positions */
			.symbol.s1 { grid-column: 1; grid-row: 1; opacity: 0.5; }
			.symbol.s2 { grid-column: 2; grid-row: 1; opacity: 0.7; transform: translateY(-10px); }
			.symbol.s3 { grid-column: 3; grid-row: 1; opacity: 0.4; }
			.symbol.s4 { grid-column: 4; grid-row: 1; opacity: 0.6; transform: translateX(15px); }
			.symbol.s5 { grid-column: 5; grid-row: 1; opacity: 0.5; }
			.symbol.s6 { grid-column: 6; grid-row: 1; opacity: 0.65; transform: translateY(10px); }
			.symbol.s7 { grid-column: 7; grid-row: 1; opacity: 0.7; }
			.symbol.s8 { grid-column: 8; grid-row: 1; opacity: 0.45; transform: translateX(-10px); }
			.symbol.s9 { grid-column: 9; grid-row: 1; opacity: 0.6; }
			.symbol.s10 { grid-column: 10; grid-row: 1; opacity: 0.55; }

			.symbol.s11 { grid-column: 1; grid-row: 2; opacity: 0.6; transform: translateX(10px); }
			.symbol.s12 { grid-column: 2; grid-row: 2; opacity: 0.5; }
			.symbol.s13 { grid-column: 3; grid-row: 2; opacity: 0.7; transform: translateY(15px); }
			.symbol.s14 { grid-column: 4; grid-row: 2; opacity: 0.45; }
			.symbol.s15 { grid-column: 5; grid-row: 2; opacity: 0.65; }
			.symbol.s16 { grid-column: 6; grid-row: 2; opacity: 0.55; transform: translateX(-15px); }
			.symbol.s17 { grid-column: 7; grid-row: 2; opacity: 0.6; }
			.symbol.s18 { grid-column: 8; grid-row: 2; opacity: 0.7; transform: translateY(-10px); }
			.symbol.s19 { grid-column: 9; grid-row: 2; opacity: 0.5; }
			.symbol.s20 { grid-column: 10; grid-row: 2; opacity: 0.6; }

			.symbol.s21 { grid-column: 1; grid-row: 3; opacity: 0.55; }
			.symbol.s22 { grid-column: 2; grid-row: 3; opacity: 0.65; transform: translateY(12px); }
			.symbol.s23 { grid-column: 3; grid-row: 3; opacity: 0.5; }
			.symbol.s24 { grid-column: 4; grid-row: 3; opacity: 0.7; transform: translateX(10px); }
			.symbol.s25 { grid-column: 5; grid-row: 3; opacity: 0.6; }
			.symbol.s26 { grid-column: 6; grid-row: 3; opacity: 0.5; }
			.symbol.s27 { grid-column: 7; grid-row: 3; opacity: 0.65; transform: translateY(-12px); }
			.symbol.s28 { grid-column: 8; grid-row: 3; opacity: 0.55; }
			.symbol.s29 { grid-column: 9; grid-row: 3; opacity: 0.7; transform: translateX(-10px); }
			.symbol.s30 { grid-column: 10; grid-row: 3; opacity: 0.45; }

			.symbol.s31 { grid-column: 1; grid-row: 4; opacity: 0.7; transform: translateY(10px); }
			.symbol.s32 { grid-column: 2; grid-row: 4; opacity: 0.5; }
			.symbol.s33 { grid-column: 3; grid-row: 4; opacity: 0.6; transform: translateX(15px); }
			.symbol.s34 { grid-column: 4; grid-row: 4; opacity: 0.55; }
			.symbol.s35 { grid-column: 5; grid-row: 4; opacity: 0.65; }
			.symbol.s36 { grid-column: 6; grid-row: 4; opacity: 0.5; transform: translateY(-15px); }
			.symbol.s37 { grid-column: 7; grid-row: 4; opacity: 0.6; }
			.symbol.s38 { grid-column: 8; grid-row: 4; opacity: 0.7; }
			.symbol.s39 { grid-column: 9; grid-row: 4; opacity: 0.45; transform: translateX(-12px); }
			.symbol.s40 { grid-column: 10; grid-row: 4; opacity: 0.6; }

			.symbol.s41 { grid-column: 1; grid-row: 5; opacity: 0.6; }
			.symbol.s42 { grid-column: 2; grid-row: 5; opacity: 0.55; transform: translateY(10px); }
			.symbol.s43 { grid-column: 3; grid-row: 5; opacity: 0.7; }
			.symbol.s44 { grid-column: 4; grid-row: 5; opacity: 0.5; transform: translateX(10px); }
			.symbol.s45 { grid-column: 5; grid-row: 5; opacity: 0.65; }
			.symbol.s46 { grid-column: 6; grid-row: 5; opacity: 0.6; }
			.symbol.s47 { grid-column: 7; grid-row: 5; opacity: 0.5; transform: translateY(-10px); }
			.symbol.s48 { grid-column: 8; grid-row: 5; opacity: 0.65; }
			.symbol.s49 { grid-column: 9; grid-row: 5; opacity: 0.55; }
			.symbol.s50 { grid-column: 10; grid-row: 5; opacity: 0.7; transform: translateX(-10px); }

			/* Central content frame */
			.content-frame {
				position: relative;
				z-index: 2;
				max-width: 700px;
				width: 100%;
				padding: 3rem 2.5rem;
				background: rgba(8, 19, 13, 0.75);
				border: 2px solid rgba(114, 168, 129, 0.3);
				box-shadow: 
					0 0 40px rgba(61, 117, 79, 0.2),
					inset 0 0 30px rgba(5, 11, 7, 0.5);
				backdrop-filter: blur(2px);
			}

			.content-frame::before {
				content: '';
				position: absolute;
				inset: 8px;
				border: 1px solid rgba(207, 178, 106, 0.15);
				pointer-events: none;
			}

			/* Title block */
			.title-block {
				text-align: center;
				margin-bottom: 2.5rem;
			}

			.eyebrow {
				margin: 0 0 1rem;
				font-family: 'Cinzel', serif;
				font-size: 0.9rem;
				font-weight: 600;
				letter-spacing: 0.25em;
				text-transform: uppercase;
				color: var(--text-muted);
			}

			h1 {
				margin: 0 0 1rem;
				font-family: 'Cinzel', serif;
				font-size: clamp(2.2rem, 6vw, 3.8rem);
				font-weight: 900;
				line-height: 1.1;
				color: var(--text-light);
				text-shadow: 0 0 20px rgba(94, 148, 106, 0.3);
			}

			.tagline {
				margin: 0;
				font-size: 1.1rem;
				line-height: 1.5;
				color: var(--text-muted);
				font-style: italic;
			}

			/* Description block */
			.description-block {
				margin-bottom: 2rem;
				padding: 1.5rem 0;
				border-top: 1px solid rgba(114, 168, 129, 0.2);
				border-bottom: 1px solid rgba(114, 168, 129, 0.2);
			}

			.description-block p {
				margin: 0;
				font-size: 1.15rem;
				line-height: 1.7;
				color: var(--text-light);
				text-align: justify;
				hyphens: auto;
			}

			/* Archive link */
			.archive-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.5rem;
				font-family: 'Cinzel', serif;
				font-weight: 600;
				font-size: 0.85rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				border: 2px solid rgba(207, 178, 106, 0.4);
				background: rgba(61, 117, 79, 0.15);
				transition: all 0.2s;
			}

			.archive-link:hover {
				border-color: var(--accent-gold);
				background: rgba(61, 117, 79, 0.25);
				box-shadow: 0 0 15px rgba(207, 178, 106, 0.2);
			}

			.archive-link svg {
				fill: none;
				stroke: currentColor;
				stroke-width: 2;
				stroke-linecap: round;
				stroke-linejoin: round;
			}

			/* Responsive adjustments */
			@media (max-width: 900px) {
				.symbol-field {
					grid-template-columns: repeat(8, 1fr);
					gap: 0.75rem;
					padding: 1.5rem;
				}

				.symbol {
					max-width: 35px;
					max-height: 35px;
				}

				/* Hide every 3rd symbol on smaller screens for less density */
				.symbol.s3, .symbol.s6, .symbol.s9,
				.symbol.s13, .symbol.s16, .symbol.s19,
				.symbol.s23, .symbol.s26, .symbol.s29,
				.symbol.s33, .symbol.s36, .symbol.s39,
				.symbol.s43, .symbol.s46, .symbol.s49 {
					display: none;
				}
			}

			@media (max-width: 600px) {
				.curiosity-cabinet {
					padding: 1.5rem 0.75rem;
				}

				.content-frame {
					padding: 2rem 1.5rem;
				}

				.symbol-field {
					grid-template-columns: repeat(6, 1fr);
					gap: 0.5rem;
					padding: 1rem;
				}

				.symbol {
					max-width: 30px;
					max-height: 30px;
				}

				/* Hide more symbols on mobile */
				.symbol.s2, .symbol.s5, .symbol.s8,
				.symbol.s12, .symbol.s15, .symbol.s18,
				.symbol.s22, .symbol.s25, .symbol.s28,
				.symbol.s32, .symbol.s35, .symbol.s38,
				.symbol.s42, .symbol.s45, .symbol.s48 {
					display: none;
				}

				h1 {
					font-size: clamp(1.8rem, 5vw, 2.5rem);
				}

				.tagline {
					font-size: 1rem;
				}

				.description-block p {
					font-size: 1.05rem;
				}
			}
		</style>
	</body>
</html>
