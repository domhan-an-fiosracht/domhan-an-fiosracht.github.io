<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Domhan an Fiosracht — World of Curiosity</title>
		<meta name="description" content="Domhan an Fiosracht is a world of curiosity, language, and quiet AI experiments at the edge of wonder." />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Cormorant+Garamond:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main class="manuscript-page">
			<!-- Ornate border frame -->
			<svg class="border-frame" viewBox="0 0 100 100" preserveAspectRatio="none">
				<path class="border-line" d="M2,2 L98,2 L98,98 L2,98 Z" />
				<path class="border-line inner" d="M4,4 L96,4 L96,96 L4,96 Z" />
			</svg>

			<!-- Corner ornaments with Celtic knots -->
			<svg class="corner-ornament top-left" viewBox="0 0 100 100">
				<path class="knot" d="M10,50 Q10,10 50,10 Q90,10 90,50 M50,10 L50,90 M10,50 Q10,90 50,90 Q90,90 90,50" />
				<circle class="knot-dot" cx="50" cy="50" r="4" />
			</svg>
			<svg class="corner-ornament top-right" viewBox="0 0 100 100">
				<path class="knot" d="M10,50 Q10,10 50,10 Q90,10 90,50 M50,10 L50,90 M10,50 Q10,90 50,90 Q90,90 90,50" />
				<circle class="knot-dot" cx="50" cy="50" r="4" />
			</svg>
			<svg class="corner-ornament bottom-left" viewBox="0 0 100 100">
				<path class="knot" d="M10,50 Q10,10 50,10 Q90,10 90,50 M50,10 L50,90 M10,50 Q10,90 50,90 Q90,90 90,50" />
				<circle class="knot-dot" cx="50" cy="50" r="4" />
			</svg>
			<svg class="corner-ornament bottom-right" viewBox="0 0 100 100">
				<path class="knot" d="M10,50 Q10,10 50,10 Q90,10 90,50 M50,10 L50,90 M10,50 Q10,90 50,90 Q90,90 90,50" />
				<circle class="knot-dot" cx="50" cy="50" r="4" />
			</svg>

			<!-- Multi-panel content grid -->
			<div class="manuscript-grid">
				<!-- Header panel with title -->
				<div class="panel header-panel">
					<svg class="panel-decoration" viewBox="0 0 300 40">
						<path class="flourish" d="M10,20 Q50,10 150,20 Q250,30 290,20" />
						<circle class="dot" cx="150" cy="20" r="3" />
						<circle class="dot" cx="80" cy="18" r="2" />
						<circle class="dot" cx="220" cy="22" r="2" />
					</svg>
					<h1 class="manuscript-title">
						<span class="title-line gaelic">Domhan an Fiosracht</span>
						<span class="title-line english">World of Curiosity</span>
					</h1>
					<svg class="panel-decoration bottom" viewBox="0 0 300 40">
						<path class="flourish" d="M10,20 Q50,30 150,20 Q250,10 290,20" />
					</svg>
				</div>

				<!-- Left panel: Compass and cartographic elements -->
				<div class="panel compass-panel">
					<svg class="cartographer-compass" viewBox="0 0 200 200">
						<circle class="compass-circle outer" cx="100" cy="100" r="90" />
						<circle class="compass-circle mid" cx="100" cy="100" r="70" />
						<circle class="compass-circle inner" cx="100" cy="100" r="50" />
						<g class="compass-directions">
							<text x="100" y="25" class="direction-label">N</text>
							<text x="175" y="105" class="direction-label">E</text>
							<text x="100" y="185" class="direction-label">S</text>
							<text x="25" y="105" class="direction-label">W</text>
						</g>
						<path class="compass-rose" d="M100,40 L110,95 L100,100 L90,95 Z" />
						<path class="compass-rose" d="M160,100 L105,110 L100,100 L105,90 Z" />
						<path class="compass-rose" d="M100,160 L110,105 L100,100 L90,105 Z" />
						<path class="compass-rose" d="M40,100 L95,110 L100,100 L95,90 Z" />
						<circle class="compass-center" cx="100" cy="100" r="8" />
					</svg>
					<p class="panel-label">Carta Marina</p>
				</div>

				<!-- Center panel: Main text block -->
				<div class="panel text-panel">
					<div class="illuminated-letter">D</div>
					<p class="manuscript-text">
						Here lies a cabinet of curiosities, a cartographer's study where ancient knowledge meets modern wonder. Within these digital vellum pages, one discovers experiments in language, thought, and the liminal spaces between human and machine cognition.
					</p>
					<div class="text-divider">
						<svg viewBox="0 0 200 20">
							<path class="divider-line" d="M10,10 L90,10 M110,10 L190,10" />
							<circle class="divider-dot" cx="100" cy="10" r="4" />
						</svg>
					</div>
					<p class="manuscript-text secondary">
						Each artifact catalogued with care, each specimen preserved in amber notation, awaiting the curious mind to unlock its secrets.
					</p>
				</div>

				<!-- Right panel: Celtic knotwork -->
				<div class="panel knotwork-panel">
					<svg class="celtic-knot" viewBox="0 0 160 160">
						<path class="knot-path" d="M30,80 Q30,30 80,30 Q130,30 130,80 Q130,130 80,130 Q30,130 30,80 Z" />
						<path class="knot-path" d="M50,80 Q50,50 80,50 Q110,50 110,80 Q110,110 80,110 Q50,110 50,80 Z" />
						<path class="knot-weave" d="M30,60 L130,100 M30,100 L130,60" />
						<circle class="knot-node" cx="80" cy="80" r="6" />
						<circle class="knot-node" cx="55" cy="70" r="4" />
						<circle class="knot-node" cx="105" cy="90" r="4" />
						<circle class="knot-node" cx="55" cy="90" r="4" />
						<circle class="knot-node" cx="105" cy="70" r="4" />
					</svg>
					<p class="panel-label">Snaidhm Ceilteach</p>
				</div>

				<!-- Bottom left: Specimen illustration -->
				<div class="panel specimen-panel">
					<svg class="specimen-drawing" viewBox="0 0 180 140">
						<g class="botanical">
							<path class="stem" d="M90,120 Q85,80 90,40" />
							<path class="leaf" d="M90,70 Q70,75 65,85 Q70,95 90,90" />
							<path class="leaf" d="M90,60 Q110,65 115,75 Q110,85 90,80" />
							<path class="leaf" d="M90,50 Q70,55 65,65 Q70,75 90,70" />
							<circle class="flower" cx="90" cy="35" r="8" />
							<circle class="flower-center" cx="90" cy="35" r="3" />
						</g>
					</svg>
					<p class="specimen-label">Specimen XLII</p>
					<p class="specimen-note">Flora Digitalis</p>
				</div>

				<!-- Bottom center: Archive link -->
				<div class="panel archive-panel">
					<svg class="archive-seal" viewBox="0 0 120 120">
						<circle class="seal-ring" cx="60" cy="60" r="50" />
						<circle class="seal-ring inner" cx="60" cy="60" r="40" />
						<path class="seal-mark" d="M40,60 L60,40 L80,60 L60,80 Z" />
						<text x="60" y="100" class="seal-text">MDCCXC</text>
					</svg>
					<a class="archive-link" href="https://github.com/domhan-an-fiosracht" target="_blank" rel="noopener">
						<span class="link-text">Enter the Archive</span>
						<svg class="link-arrow" viewBox="0 0 20 20">
							<path d="M5,10 L15,10 M12,7 L15,10 L12,13" />
						</svg>
					</a>
				</div>

				<!-- Bottom right: Map fragment -->
				<div class="panel map-panel">
					<svg class="map-fragment" viewBox="0 0 160 140">
						<path class="coastline" d="M10,70 Q30,50 50,60 T90,80 T130,70 T150,90" />
						<path class="coastline" d="M10,90 Q35,110 60,95 T100,110 T140,100 T150,110" />
						<circle class="landmark" cx="70" cy="75" r="3" />
						<circle class="landmark" cx="110" cy="95" r="3" />
						<line class="latitude" x1="10" y1="60" x2="150" y2="60" />
						<line class="latitude" x1="10" y1="100" x2="150" y2="100" />
						<text class="map-label" x="75" y="40">Terra Incognita</text>
					</svg>
					<p class="panel-label">Mappa Mundi</p>
				</div>
			</div>

			<!-- Paper texture overlay -->
			<div class="paper-texture" aria-hidden="true"></div>
		</main>

		<style>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			:root {
				--parchment: #f4ebe1;
				--ink-dark: #2b1810;
				--ink-medium: #4a3426;
				--ink-light: #6d5647;
				--sepia: #b8966d;
				--gold: #c9a961;
				--border-color: #8b6f47;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				background: var(--parchment);
				color: var(--ink-dark);
				font-family: 'EB Garamond', 'Cormorant Garamond', Georgia, serif;
				overflow-x: hidden;
			}

			a {
				color: inherit;
			}

			.manuscript-page {
				position: relative;
				min-height: 100vh;
				padding: 2rem 1.5rem;
				background:
					radial-gradient(circle at 20% 30%, rgba(139, 111, 71, 0.04), transparent 40%),
					radial-gradient(circle at 80% 70%, rgba(201, 169, 97, 0.06), transparent 45%),
					linear-gradient(135deg, #f4ebe1 0%, #ede4d8 50%, #f4ebe1 100%);
			}

			/* Ornate border frame */
			.border-frame {
				position: fixed;
				inset: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 10;
			}

			.border-line {
				fill: none;
				stroke: var(--border-color);
				stroke-width: 0.3;
			}

			.border-line.inner {
				stroke-width: 0.15;
				stroke-dasharray: 4 2;
			}

			/* Corner ornaments */
			.corner-ornament {
				position: fixed;
				width: 80px;
				height: 80px;
				pointer-events: none;
				z-index: 11;
			}

			.top-left {
				top: 1.5rem;
				left: 1.5rem;
			}

			.top-right {
				top: 1.5rem;
				right: 1.5rem;
				transform: rotate(90deg);
			}

			.bottom-left {
				bottom: 1.5rem;
				left: 1.5rem;
				transform: rotate(-90deg);
			}

			.bottom-right {
				bottom: 1.5rem;
				right: 1.5rem;
				transform: rotate(180deg);
			}

			.knot {
				fill: none;
				stroke: var(--gold);
				stroke-width: 1.5;
				stroke-linecap: round;
			}

			.knot-dot {
				fill: var(--gold);
			}

			/* Paper texture */
			.paper-texture {
				position: fixed;
				inset: 0;
				pointer-events: none;
				background-image: 
					repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(139, 111, 71, 0.02) 2px, rgba(139, 111, 71, 0.02) 4px),
					repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(139, 111, 71, 0.02) 2px, rgba(139, 111, 71, 0.02) 4px);
				opacity: 0.5;
				z-index: 1;
			}

			/* Multi-panel grid */
			.manuscript-grid {
				position: relative;
				z-index: 2;
				max-width: 1200px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem 1.5rem;
				padding: 1rem;
			}

			/* Panel styles */
			.panel {
				background: rgba(255, 255, 255, 0.4);
				border: 2px solid var(--sepia);
				padding: 1.5rem;
				box-shadow: 
					0 2px 8px rgba(43, 24, 16, 0.1),
					inset 0 0 20px rgba(255, 255, 255, 0.5);
				position: relative;
			}

			.panel::before {
				content: '';
				position: absolute;
				inset: 4px;
				border: 1px solid rgba(201, 169, 97, 0.3);
				pointer-events: none;
			}

			/* Header panel - spans full width */
			.header-panel {
				grid-column: 1 / -1;
				text-align: center;
				padding: 2rem 1.5rem;
			}

			.panel-decoration {
				width: 100%;
				max-width: 300px;
				height: 40px;
				margin: 0 auto 1rem;
			}

			.panel-decoration.bottom {
				margin: 1rem auto 0;
			}

			.flourish {
				fill: none;
				stroke: var(--gold);
				stroke-width: 1.2;
			}

			.dot {
				fill: var(--gold);
			}

			.manuscript-title {
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.title-line {
				display: block;
			}

			.title-line.gaelic {
				font-family: 'Cinzel', serif;
				font-size: clamp(1.2rem, 3vw, 1.8rem);
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--ink-medium);
				font-weight: 700;
			}

			.title-line.english {
				font-family: 'Cinzel', serif;
				font-size: clamp(2rem, 5vw, 3.5rem);
				font-weight: 900;
				color: var(--ink-dark);
				letter-spacing: 0.05em;
			}

			/* Compass panel */
			.compass-panel {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 1rem;
			}

			.cartographer-compass {
				width: 100%;
				max-width: 200px;
				height: auto;
			}

			.compass-circle {
				fill: none;
				stroke: var(--ink-medium);
			}

			.compass-circle.outer {
				stroke-width: 2;
			}

			.compass-circle.mid {
				stroke-width: 1.5;
				stroke-dasharray: 5 5;
			}

			.compass-circle.inner {
				stroke-width: 1;
			}

			.direction-label {
				font-family: 'Cinzel', serif;
				font-size: 20px;
				font-weight: 700;
				fill: var(--ink-dark);
				text-anchor: middle;
			}

			.compass-rose {
				fill: var(--gold);
				stroke: var(--ink-dark);
				stroke-width: 1;
			}

			.compass-center {
				fill: var(--ink-dark);
			}

			/* Text panel */
			.text-panel {
				grid-column: 2;
				grid-row: 2 / 4;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.illuminated-letter {
				font-family: 'Cinzel', serif;
				font-size: 4rem;
				line-height: 1;
				font-weight: 900;
				color: var(--gold);
				text-shadow: 2px 2px 0 var(--ink-dark);
				float: left;
				margin-right: 0.5rem;
				margin-top: -0.2rem;
			}

			.manuscript-text {
				font-size: 1.1rem;
				line-height: 1.6;
				margin: 0;
				text-align: justify;
				hyphens: auto;
			}

			.manuscript-text.secondary {
				font-size: 1rem;
				color: var(--ink-medium);
				font-style: italic;
			}

			.text-divider {
				width: 100%;
				margin: 1rem 0;
			}

			.text-divider svg {
				width: 100%;
				height: 20px;
			}

			.divider-line {
				stroke: var(--sepia);
				stroke-width: 1;
			}

			.divider-dot {
				fill: var(--sepia);
			}

			/* Knotwork panel */
			.knotwork-panel {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 1rem;
			}

			.celtic-knot {
				width: 100%;
				max-width: 160px;
				height: auto;
			}

			.knot-path {
				fill: none;
				stroke: var(--gold);
				stroke-width: 2.5;
			}

			.knot-weave {
				fill: none;
				stroke: var(--ink-medium);
				stroke-width: 1.5;
				stroke-dasharray: 8 4;
			}

			.knot-node {
				fill: var(--ink-dark);
				stroke: var(--gold);
				stroke-width: 1;
			}

			/* Specimen panel */
			.specimen-panel {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
			}

			.specimen-drawing {
				width: 100%;
				max-width: 180px;
				height: auto;
			}

			.stem {
				fill: none;
				stroke: var(--ink-medium);
				stroke-width: 2;
			}

			.leaf {
				fill: rgba(109, 86, 71, 0.2);
				stroke: var(--ink-medium);
				stroke-width: 1.5;
			}

			.flower {
				fill: none;
				stroke: var(--gold);
				stroke-width: 2;
			}

			.flower-center {
				fill: var(--gold);
			}

			.specimen-label {
				margin: 0;
				font-family: 'Cinzel', serif;
				font-size: 0.9rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.1em;
			}

			.specimen-note {
				margin: 0;
				font-size: 0.85rem;
				font-style: italic;
				color: var(--ink-light);
			}

			/* Archive panel */
			.archive-panel {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 1rem;
			}

			.archive-seal {
				width: 100%;
				max-width: 120px;
				height: auto;
			}

			.seal-ring {
				fill: none;
				stroke: var(--gold);
				stroke-width: 2;
			}

			.seal-ring.inner {
				stroke-width: 1.5;
				stroke-dasharray: 3 3;
			}

			.seal-mark {
				fill: var(--gold);
				stroke: var(--ink-dark);
				stroke-width: 1.5;
			}

			.seal-text {
				font-family: 'Cinzel', serif;
				font-size: 12px;
				font-weight: 700;
				fill: var(--ink-dark);
				text-anchor: middle;
			}

			.archive-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				text-decoration: none;
				padding: 0.75rem 1.25rem;
				border: 2px solid var(--border-color);
				background: rgba(201, 169, 97, 0.1);
				font-family: 'Cinzel', serif;
				font-weight: 600;
				font-size: 0.9rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				transition: all 0.2s;
			}

			.archive-link:hover {
				background: rgba(201, 169, 97, 0.2);
				border-color: var(--gold);
			}

			.link-arrow {
				width: 20px;
				height: 20px;
			}

			.link-arrow path {
				fill: none;
				stroke: currentColor;
				stroke-width: 2;
				stroke-linecap: round;
				stroke-linejoin: round;
			}

			/* Map panel */
			.map-panel {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
			}

			.map-fragment {
				width: 100%;
				max-width: 160px;
				height: auto;
			}

			.coastline {
				fill: none;
				stroke: var(--ink-medium);
				stroke-width: 2;
			}

			.landmark {
				fill: var(--ink-dark);
			}

			.latitude {
				stroke: var(--sepia);
				stroke-width: 0.5;
				stroke-dasharray: 4 2;
			}

			.map-label {
				font-family: 'EB Garamond', serif;
				font-size: 14px;
				font-style: italic;
				fill: var(--ink-medium);
				text-anchor: middle;
			}

			.panel-label {
				margin: 0;
				font-family: 'EB Garamond', serif;
				font-size: 0.95rem;
				font-style: italic;
				color: var(--ink-medium);
				text-align: center;
			}

			/* Responsive layout */
			@media (max-width: 900px) {
				.manuscript-grid {
					grid-template-columns: 1fr 1fr;
					gap: 1.5rem 1rem;
				}

				.text-panel {
					grid-column: 1 / -1;
					grid-row: auto;
				}
			}

			@media (max-width: 600px) {
				.manuscript-page {
					padding: 1.5rem 1rem;
				}

				.manuscript-grid {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				.corner-ornament {
					width: 60px;
					height: 60px;
				}

				.top-left,
				.top-right {
					top: 1rem;
				}

				.top-left,
				.bottom-left {
					left: 1rem;
				}

				.top-right,
				.bottom-right {
					right: 1rem;
				}

				.bottom-left,
				.bottom-right {
					bottom: 1rem;
				}

				.text-panel {
					grid-column: 1;
				}

				.manuscript-text {
					font-size: 1rem;
				}

				.illuminated-letter {
					font-size: 3rem;
				}
			}
		</style>
	</body>
</html>
